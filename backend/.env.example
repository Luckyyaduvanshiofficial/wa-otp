# Local dev environment — copy to backend/.env and fill in.
# Never commit .env (it is gitignored).

# --- PocketBase control plane -------------------------------------------
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Collection namespace prefix. Use "waotp_" when sharing a PocketBase
# instance with other projects: collections become waotp_api_keys, … and the
# app gets its own waotp_users auth collection, so developer accounts and
# data stay fully separate from other apps. Leave empty for a dedicated
# PocketBase created via pb_migrations (then the stock users collection is
# extended with plan/status instead).
WAOTP_PB_COLLECTIONS_PREFIX=waotp_

# --- Secrets -------------------------------------------------------------
# Encrypts the Meta token at rest in the PB `settings` row. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WAOTP_FERNET_KEY=

# Shared secret for the Telegram webhook. Must equal the `secret_token`
# passed to setWebhook (scripts/set_telegram_webhook.py does this).
TELEGRAM_WEBHOOK_SECRET=

# --- App -----------------------------------------------------------------
# CORS origin of the Next.js dashboard, e.g. https://app.yourdomain.in
# (http://localhost:3000 for local dev — without this the browser blocks
# all dashboard calls to the API)
DASHBOARD_ORIGIN=

# Dev flag: fake provider delivery so send/verify works with no Meta/Telegram
# credentials. MUST be 0/absent in production.
WAOTP_MOCK_DELIVERY=1
