# WA OTP dashboard — all values here are public (no secrets client-side).
# Copy to .env.local: cp .env.local.example .env.local

# Self-hosted PocketBase. This instance is shared with another project, so the
# collection prefix below is what keeps the two apart — see the next block.
NEXT_PUBLIC_PB_URL=https://pb.codaipro.com

# Isolation from the other project on the same PocketBase instance.
# Must match WAOTP_PB_COLLECTIONS_PREFIX in backend/.env (default `waotp_`).
# Never leave this empty against a shared instance: an unprefixed build would
# address that project's stock `users` and `api_keys` collections.
NEXT_PUBLIC_PB_COLLECTIONS_PREFIX=waotp_

# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical origin of this app. Used as the PocketBase password-reset return
# address, so it must be the origin users actually reach — set it per
# environment rather than relying on window.location.origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: `owner/repo` of this project on GitHub.
# When set, the landing nav shows a live star count (api.github.com, cached
# for an hour) and the footer grows a github link. When unset, both surfaces
# render nothing — no placeholder link and no invented count.
# NEXT_PUBLIC_GITHUB_REPO=owner/repo

# Optional Sentry (leave DSN unset to keep Sentry inert)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ORG=
# NEXT_PUBLIC_SENTRY_PROJECT=
# NEXT_PUBLIC_SENTRY_DISABLED=true
